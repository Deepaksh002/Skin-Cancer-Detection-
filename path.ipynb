import os

def folder_tree(path, level=3):
    path = os.path.abspath(path)
    for root, dirs, files in os.walk(path):
        depth = root[len(path):].count(os.sep)
        if depth <= level:
            indent = " " * 4 * depth
            print(f"{indent}{os.path.basename(root)}/")

folder_tree("Dataset", level=3)